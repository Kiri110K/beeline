{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visual Files Tauri Benchmark",
  "version": "0.1.0",
  "identifier": "com.kiri.visual-files-tauri-benchmark",
  "build": {
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Visual Files Tauri Benchmark",
        "width": 920,
        "height": 640,
        "minWidth": 720,
        "minHeight": 440,
        "center": true,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "targets": ["app"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
