{
  "name": "visual-files-tauri-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "check:contract": "bun scripts/static-check.ts",
    "test": "bun run check && bun run check:contract && cargo test --manifest-path src-tauri/Cargo.toml --offline",
    "tauri": "tauri",
    "build:app": "tauri build --bundles app",
    "summarize": "bun scripts/summarize.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "@tauri-apps/api": "^2.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
